{
  "name": "opencode-go-usage-plugin",
  "version": "0.8.0",
  "description": "OpenCode Go plan usage in the TUI and desktop, plus automatic account failover",
  "type": "module",
  "license": "MIT",
  "repository": "github:ionutale/opencode-go-usage-plugin",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "server.ts",
    "tui.tsx",
    "tsconfig.json",
    "!src/*.test.ts",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "build:tui": "node scripts/build-tui.mjs",
    "build:gui": "vite build",
    "screenshots": "tsx scripts/screenshots.mjs",
    "prepack": "pnpm build:tui && pnpm build:gui"
  },
  "engines": {
    "node": ">=20.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.3",
    "solid-js": "^1.9.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
