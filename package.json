{
  "name": "opencode-go-usage-plugin",
  "version": "0.5.2",
  "description": "OpenCode Go plan usage (rolling / weekly / monthly) in the sidebar and as a desktop composer pill; token usage view moved to opencode-token-usage-dashboard",
  "type": "module",
  "license": "MIT",
  "repository": "github:ionutale/opencode-go-usage-plugin",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "server.ts",
    "tui.tsx",
    "tsconfig.json",
    "!src/*.test.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "build:tui": "node scripts/build-tui.mjs",
    "build:gui": "vite build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/node": "^26.6.3",
    "solid-js": "^1.9.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.0.2"
  }
}
